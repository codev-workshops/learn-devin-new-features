{
  "name": "harbourline",
  "version": "0.1.0",
  "private": true,
  "description": "Harbourline — a deliberately imperfect multi-brand e-commerce platform used as the fixture for the Applied Devin Lab course.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --if-present --parallel --no-bail run dev",
    "test": "pnpm -r --if-present run test",
    "lint": "prettier --check . && eslint . && pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "build": "pnpm -r --if-present run build",
    "labs:build": "pnpm --filter @harbourline/labs run build",
    "coach:dryrun": "pnpm --filter @harbourline/labs run coach:dryrun",
    "lab:reset": "node scripts/lab-reset.mjs",
    "lab:start": "bash scripts/lab.sh start",
    "lab:cleanup": "bash scripts/lab.sh cleanup",
    "db:migrate": "pnpm --filter @harbourline/api run db:migrate",
    "db:seed": "pnpm --filter @harbourline/api run db:seed",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "gates": "pnpm test && pnpm lint && pnpm build && pnpm labs:build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
