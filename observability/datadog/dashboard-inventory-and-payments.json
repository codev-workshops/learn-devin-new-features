{
  "id": "k4d-3-inv",
  "title": "Harbourline — Inventory & Payments",
  "description": "On-hand stock, checkout throughput and PayGate webhook health for both brands. Linked from monitors 48213771 and 48213802.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "brand",
      "prefix": "brand",
      "default": "lumen-home",
      "available_values": ["lumen-home", "trailhead-supply"]
    },
    { "name": "sku", "prefix": "sku", "default": "*" }
  ],
  "widgets": [
    {
      "id": 1,
      "definition": {
        "type": "timeseries",
        "title": "On-hand by SKU (min) — negative means oversold",
        "requests": [
          { "q": "min:harbourline.inventory.on_hand{$brand,$sku} by {sku}", "display_type": "line" }
        ],
        "markers": [{ "value": "y = 0", "display_type": "error dashed", "label": "oversold" }]
      }
    },
    {
      "id": 2,
      "definition": {
        "type": "timeseries",
        "title": "Checkouts per minute by outcome",
        "requests": [
          {
            "q": "sum:harbourline.checkout.completed{$brand} by {outcome}.as_count()",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "id": 3,
      "definition": {
        "type": "timeseries",
        "title": "Reservation p95 latency (ms) — flat line + oversell = no row lock",
        "requests": [{ "q": "p95:harbourline.reservation.duration{$brand}", "display_type": "line" }]
      }
    },
    {
      "id": 4,
      "definition": {
        "type": "query_value",
        "title": "Webhook failure rate (15m)",
        "requests": [
          {
            "q": "( sum:harbourline.webhooks.processed{outcome:error}.as_count() / sum:harbourline.webhooks.processed{*}.as_count() ) * 100",
            "aggregator": "last"
          }
        ],
        "precision": 1,
        "custom_unit": "%"
      }
    },
    {
      "id": 5,
      "definition": {
        "type": "timeseries",
        "title": "Webhooks processed by attempt — attempt>1 is a retry storm",
        "requests": [
          { "q": "sum:harbourline.webhooks.processed{*} by {attempt}.as_count()", "display_type": "bars" }
        ]
      }
    },
    {
      "id": 6,
      "definition": {
        "type": "toplist",
        "title": "Duplicate event_id deliveries (24h)",
        "requests": [
          {
            "q": "top(sum:harbourline.webhooks.duplicate_event_id{*} by {order_number}.as_count(), 10, 'sum', 'desc')"
          }
        ]
      }
    },
    {
      "id": 7,
      "definition": {
        "type": "event_timeline",
        "title": "Deploys",
        "query": "tags:service:harbourline-api,deploy"
      }
    }
  ],
  "notify_list": ["ops@harbourline.test"],
  "created_at": "2026-09-14T10:10:00Z",
  "modified_at": "2026-10-21T22:41:07Z"
}
