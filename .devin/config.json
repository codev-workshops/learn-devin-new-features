{
  "$schema": "https://docs.devin.ai/schemas/project-config.json",
  "name": "harbourline",
  "description": "Harbourline: a deliberately imperfect multi-brand e-commerce fixture used by the Devin practice course in labs/.",
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build*)",
      "Bash(pnpm gates*)",
      "Bash(pnpm labs:build*)",
      "Bash(pnpm coach:dryrun*)",
      "Bash(pnpm lab:reset*)",
      "Bash(bash scripts/lab.sh *)",
      "Bash(pnpm lab:cleanup*)",
      "Bash(pnpm lab:start*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec *)",
      "Bash(docker compose *)",
      "Bash(git *)",
      "Bash(date +%s)"
    ],
    "deny": ["Bash(git push --force*)", "Bash(docker compose down -v*)"]
  }
}
