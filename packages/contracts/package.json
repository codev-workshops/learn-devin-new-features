{
  "name": "@kade/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Frozen Kadé Commerce contracts: OpenAPI, seed-data spec and shared TypeScript types.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi.yaml",
    "./seed-spec.yaml": "./seed-spec.yaml"
  },
  "files": [
    "dist",
    "openapi.yaml",
    "seed-spec.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
