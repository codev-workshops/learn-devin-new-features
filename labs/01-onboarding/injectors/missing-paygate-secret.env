# Lab 01 injector: the fake payment provider signs with a rotated key the services do not know.
# Source this only in the shell that starts services/paygate-fake. Not a real secret.
export PAYGATE_SECRET=rotated-local-key-not-shared
# Deliver to the worker inbox, which verifies signatures (the API receiver does not).
export PAYGATE_WEBHOOK_URL=http://localhost:3003/webhooks/payments
