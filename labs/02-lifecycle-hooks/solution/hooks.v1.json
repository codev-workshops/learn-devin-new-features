{
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$DEVIN_PROJECT_DIR/labs/02-lifecycle-hooks/solution/pretool-guard.mjs\"",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$DEVIN_PROJECT_DIR/labs/02-lifecycle-hooks/solution/posttool-audit.mjs\"",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$DEVIN_PROJECT_DIR/labs/02-lifecycle-hooks/solution/stop-check.mjs\"",
          "timeout": 5
        }
      ]
    }
  ]
