{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/codev-workshops/learn-devin-new-features/labs/coach-report.schema.json",
  "title": "Kadé articulation coach gap report",
  "description": "Fixed gap-report template written by every per-lab articulation coach (plan §5). Frozen after W0; W5-coach may add optional fields only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lab",
    "learner",
    "mode",
    "run",
    "timing",
    "structure",
    "fillers_and_pauses",
    "must_mention",
    "clarity",
    "scores",
    "stems",
    "previous_run_comparison"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "slug",
        "coach"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "coach": {
          "type": "string",
          "pattern": "^coach-[0-9]{2}-[a-z0-9-]+$"
        }
      }
    },
    "learner": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "dry-run",
        "live"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "timing_method",
        "timing_tolerance_seconds"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_index": {
          "type": "integer",
          "minimum": 1
        },
        "transcript": {
          "type": "string",
          "description": "Dry-run only: repo-relative path of the transcript fixture"
        },
        "timing_method": {
          "enum": [
            "markers",
            "date+%s",
            "session-timestamps"
          ]
        },
        "timing_tolerance_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "graded_by": {
          "enum": [
            "subagent",
            "inline"
          ]
        }
      }
    },
    "timing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment",
          "kind",
          "target_seconds",
          "actual_seconds",
          "delta_seconds",
          "verdict"
        ],
        "properties": {
          "segment": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Must match a coach.segments[].id in the lab's lab.json"
          },
          "kind": {
            "enum": [
              "framing",
              "checkpoint",
              "update",
              "objection"
            ]
          },
          "label": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "description": "For objections: the objection as asked, in character"
          },
          "target_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "actual_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "delta_seconds": {
            "type": "integer"
          },
          "verdict": {
            "enum": [
              "under",
              "on",
              "over"
            ]
          },
          "interruptions": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "approach",
        "evidence",
        "next_step"
      ],
      "properties": {
        "problem": {
          "$ref": "#/definitions/structurePart"
        },
        "approach": {
          "$ref": "#/definitions/structurePart"
        },
        "evidence": {
          "$ref": "#/definitions/structurePart"
        },
        "next_step": {
          "$ref": "#/definitions/structurePart"
        },
        "order_held": {
          "type": "boolean",
          "description": "Outcome → Evidence → Risk → Next action → Ask order held in the update"
        }
      }
    },
    "fillers_and_pauses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spoken_minutes",
        "filler_count",
        "filler_rate_per_minute",
        "fillers",
        "tag_questions",
        "long_pauses"
      ],
      "properties": {
        "spoken_minutes": {
          "type": "number",
          "minimum": 0
        },
        "filler_count": {
          "type": "integer",
          "minimum": 0
        },
        "filler_rate_per_minute": {
          "type": "number",
          "minimum": 0
        },
        "fillers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "word",
              "count"
            ],
            "properties": {
              "word": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "tag_questions": {
          "type": "integer",
          "minimum": 0
        },
        "tag_question_examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "long_pauses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "seconds"
            ],
            "properties": {
              "at": {
                "type": "string",
                "pattern": "^[0-9]{2}:[0-9]{2}$"
              },
              "seconds": {
                "type": "integer",
                "minimum": 8
              },
              "segment": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "must_mention": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "point",
          "weight",
          "mentioned",
          "belonged_in"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]{1,3}[0-9]{1,2}$"
          },
          "point": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1
          },
          "mentioned": {
            "type": "boolean"
          },
          "evidence_quote": {
            "type": "string"
          },
          "belonged_in": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Segment id where the point belonged"
          }
        }
      }
    },
    "clarity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caveat",
        "misrecognised_words",
        "repeated_words",
        "clarification_requests",
        "article_plural_slips"
      ],
      "properties": {
        "caveat": {
          "const": "transcript-based, approximate"
        },
        "misrecognised_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repeated_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clarification_requests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The coach's own “did you say…?” moments"
        },
        "article_plural_slips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentences_to_rerecord": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accuracy",
        "structure",
        "customer_relevance",
        "brevity_and_fluency",
        "recovery",
        "total"
      ],
      "properties": {
        "accuracy": {
          "$ref": "#/definitions/score30"
        },
        "structure": {
          "$ref": "#/definitions/score25"
        },
        "customer_relevance": {
          "$ref": "#/definitions/score20"
        },
        "brevity_and_fluency": {
          "$ref": "#/definitions/score15"
        },
        "recovery": {
          "$ref": "#/definitions/score10"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "stems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "previous_run_comparison": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "structurePart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "quote"
      ],
      "properties": {
        "status": {
          "enum": [
            "present",
            "weak",
            "missing"
          ]
        },
        "quote": {
          "type": "string",
          "description": "The sentence that carried it; empty when missing"
        }
      }
    },
    "score30": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "max",
        "anchor"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "max": {
          "const": 30
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "description": "The rubric anchor sentence that justified the score"
        }
      }
    },
    "score25": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "max",
        "anchor"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "max": {
          "const": 25
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "description": "The rubric anchor sentence that justified the score"
        }
      }
    },
    "score20": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "max",
        "anchor"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max": {
          "const": 20
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "description": "The rubric anchor sentence that justified the score"
        }
      }
    },
    "score15": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "max",
        "anchor"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "max": {
          "const": 15
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "description": "The rubric anchor sentence that justified the score"
        }
      }
    },
    "score10": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "max",
        "anchor"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "max": {
          "const": 10
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "description": "The rubric anchor sentence that justified the score"
        }
      }
    }
  }
}
