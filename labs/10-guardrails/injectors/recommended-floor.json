{
  "description": "Injector recommended-floor: the same matrix with harbourline-floor set to recommended. Compare opt-out-session and child-of-dev with the reference.",
  "profiles": {
    "harbourline-floor": {
      "scope": "enterprise",
      "enforcement": "recommended",
      "network": [
        "registry.npmjs.org",
        "*.sandbox.paygate.example"
      ],
      "mcp": [],
      "gh_token": "remove"
    },
    "harbourline-dev": {
      "scope": "org",
      "enforcement": "recommended",
      "network": [
        "registry.npmjs.org",
        "*.sandbox.paygate.example"
      ],
      "git": "full",
      "devin_mcp_read_only": false
    },
    "harbourline-automation": {
      "scope": "org",
      "enforcement": "recommended",
      "network": [
        "registry.npmjs.org"
      ],
      "git": "read-only",
      "devin_mcp_read_only": true
    }
  },
  "bindings": {
    "enterprise_default": {
      "profile": "harbourline-floor"
    },
    "org_default": {
      "profile": "harbourline-dev"
    },
    "automations_default": {
      "profile": "harbourline-automation"
    },
    "automations": {
      "webhook-triage": "inherit"
    },
    "snapshot_builds": "inherit"
  },
  "targets": {
    "dev-session": {
      "kind": "session",
      "binding": "inherit"
    },
    "opt-out-session": {
      "kind": "session",
      "binding": "none"
    },
    "webhook-triage-run": {
      "kind": "automation-session",
      "automation": "webhook-triage"
    },
    "child-of-dev": {
      "kind": "child",
      "parent": "dev-session",
      "binding": "none"
    },
    "snapshot-build": {
      "kind": "snapshot-build"
    }
  }
}
