{
  "description": "Injector floor-tightened: at T+45 the CISO narrows the PayGate entry to the API host only. Use with --then against the reference world.",
  "profiles": {
    "kade-floor": {
      "scope": "enterprise",
      "enforcement": "mandatory",
      "network": [
        "registry.npmjs.org",
        "api.sandbox.paygate.example"
      ],
      "mcp": [],
      "gh_token": "remove"
    },
    "kade-dev": {
      "scope": "org",
      "enforcement": "recommended",
      "network": [
        "registry.npmjs.org",
        "*.sandbox.paygate.example"
      ],
      "git": "full",
      "devin_mcp_read_only": false
    },
    "kade-automation": {
      "scope": "org",
      "enforcement": "recommended",
      "network": [
        "registry.npmjs.org"
      ],
      "git": "read-only",
      "devin_mcp_read_only": true
    }
  },
  "bindings": {
    "enterprise_default": {
      "profile": "kade-floor"
    },
    "org_default": {
      "profile": "kade-dev"
    },
    "automations_default": {
      "profile": "kade-automation"
    },
    "automations": {
      "webhook-triage": "inherit"
    },
    "snapshot_builds": "inherit"
  },
  "targets": {
    "dev-session": {
      "kind": "session",
      "binding": "inherit"
    },
    "opt-out-session": {
      "kind": "session",
      "binding": "none"
    },
    "webhook-triage-run": {
      "kind": "automation-session",
      "automation": "webhook-triage"
    },
    "child-of-dev": {
      "kind": "child",
      "parent": "dev-session",
      "binding": "none"
    },
    "snapshot-build": {
      "kind": "snapshot-build"
    }
  }
}
