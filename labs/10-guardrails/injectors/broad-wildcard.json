{
  "description": "Injector broad-wildcard: a draft floor written in a hurry. Run with --validate and --check registry.npmjs.org.evil.example,evilpaygate.example.",
  "profiles": {
    "harbourline-floor-draft": {
      "scope": "enterprise",
      "enforcement": "mandatory",
      "network": [
        "registry.npmjs.org*",
        "*paygate.example",
        "https://registry.npmjs.org/"
      ],
      "mcp": [],
      "gh_token": "remove"
    }
  },
  "bindings": {
    "enterprise_default": {
      "profile": "harbourline-floor-draft"
    }
  },
  "targets": {
    "dev-session": {
      "kind": "session",
      "binding": "inherit"
    }
  }
}
