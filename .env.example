# Copy to .env (gitignored). Every value is a local-development default; nothing here is a secret.
POSTGRES_USER=kade
POSTGRES_PASSWORD=kade
POSTGRES_DB=kade
POSTGRES_PORT=5432
DATABASE_URL=postgres://kade:kade@localhost:5432/kade

# services/api (W1-api)
API_PORT=3001
# services/paygate-fake (W1-worker) — HMAC key shared with the webhook consumer
PAYGATE_SECRET=kade-local-paygate-secret
PAYGATE_PORT=3002
# apps/web (W1-web)
VITE_API_URL=http://localhost:3001
