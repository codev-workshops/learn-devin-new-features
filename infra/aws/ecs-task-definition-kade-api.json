{
  "family": "kade-api",
  "taskRoleArn": "arn:aws:iam::123456789012:role/kade-api-task",
  "executionRoleArn": "arn:aws:iam::123456789012:role/kade-ecs-execution",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
  "containerDefinitions": [
    {
      "name": "api",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/kade-api:2026.10.21-lampweek",
      "essential": true,
      "portMappings": [{ "containerPort": 3001, "protocol": "tcp", "name": "http" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "API_PORT", "value": "3001" },
        { "name": "OTEL_EXPORTER_OTLP_ENDPOINT", "value": "http://datadog-agent.kade.local:4318" },
        { "name": "OTEL_SERVICE_NAME", "value": "kade-api" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:kade/prod/database-url"
        },
        {
          "name": "PAYGATE_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:kade/prod/paygate-secret"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fsS http://localhost:3001/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/kade/prod/api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ],
  "tags": [
    { "key": "service", "value": "kade-api" },
    { "key": "env", "value": "prod" },
    { "key": "team", "value": "platform" }
  ]
}
