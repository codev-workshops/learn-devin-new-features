{
  "name": "@harbourline/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kad\u00e9 Commerce order API: catalog, cart, checkout, orders, admin console and PayGate webhook receiver (Express 5 + PostgreSQL 16).",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check . && tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:migrate:down": "node scripts/migrate.mjs down",
    "db:seed": "tsx src/seed/cli.ts"
  },
  "dependencies": {
    "@harbourline/contracts": "0.1.0",
    "express": "^5.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
