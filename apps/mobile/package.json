{
  "name": "@kade/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Kad\u00e9 Commerce shopping app (Expo SDK 54, Expo Router): brand picker, catalog, cart and order status against the frozen OpenAPI contract.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --ci",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "prettier --check . && eslint . && npm run typecheck",
    "format": "prettier --write .",
    "build": "node scripts/build-fixtures.mjs && expo export --platform android --output-dir dist",
    "fixtures": "node scripts/build-fixtures.mjs"
  },
  "dependencies": {
    "expo": "~54.0.36",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "expo-constants": "~18.0.14",
    "expo-modules-core": "~3.0.30",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2",
    "@eslint/js": "^9.39.5",
    "@testing-library/react-native": "^13.3.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "msw": "^2.12.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.1.0",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1",
    "@types/jest": "^29.5.14"
  }
}
