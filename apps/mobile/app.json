{
  "expo": {
    "name": "Harbourline",
    "slug": "harbourline",
    "version": "0.1.0",
    "scheme": "harbourline",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "test.harbourline.commerce",
      "supportsTablet": false
    },
    "android": {
      "package": "test.harbourline.commerce",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiMode": "mock"
    }
  }
}
