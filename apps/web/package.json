{
  "name": "@harbourline/web",
  "version": "0.1.0",
  "private": true,
  "description": "Harbourline storefront (/shop/:brand) and merchandiser console (/admin) — React 19 + Vite, MSW mocks generated from packages/contracts.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run mocks:gen && vite",
    "build": "npm run mocks:gen && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "mocks:gen": "node scripts/gen-mocks.mjs",
    "mocks:check": "node scripts/gen-mocks.mjs --check",
    "typecheck": "tsc -b",
    "lint": "npm run mocks:check && eslint . && prettier --check . && tsc -b",
    "format": "prettier --write .",
    "test": "npm run mocks:gen && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "msw": "^2.11.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
